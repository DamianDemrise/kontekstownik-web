{
  "name": "kontekstownik-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "assets": "node scripts/build-globe-data.mjs && node scripts/build-icons.mjs",
    "build": "vite build && node scripts/check-dist.mjs",
    "preview": "vite preview --port 4188 --strictPort",
    "shots": "node scripts/screenshots.mjs",
    "zip": "node scripts/zip-dist.mjs",
    "test": "node scripts/test-materials.mjs && node scripts/test-import.mjs && node scripts/test-paging.mjs && node scripts/screenshots.mjs && node scripts/test-functional.mjs",
    "deploy": "./scripts/deploy-lh.sh",
    "verify-live": "./scripts/verify-live.sh",
    "materialy:check": "node scripts/materials-check.mjs",
    "build:przyklad": "MATERIALY_DIR=content/przyklad vite build && node scripts/check-dist.mjs",
    "import": "node scripts/import-material.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/montserrat": "^5.3.0",
    "d3-geo": "^3.1.1",
    "playwright": "1.48",
    "sharp": "^0.33.5",
    "simple-icons": "^13.21.0",
    "topojson-client": "^3.1.0",
    "vite": "^6.4.5",
    "world-atlas": "^2.0.2"
  }
}
