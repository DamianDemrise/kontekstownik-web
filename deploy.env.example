# Skopiuj do deploy.env (plik jest w .gitignore) i uzupełnij danymi z panelu LH.pl.
# Hasło NIE trafia tutaj: trzymaj je w pęku kluczy macOS (DEPLOY_LH.md, krok 4).
LH_PROTO=ftp                    # ftp (FTPS z wymuszonym TLS) albo sftp, jeśli pakiet ma SSH
LH_HOST=serwerXXXXXX.lh.pl      # z maila aktywacyjnego / panelu LH.pl
LH_USER=serwerXXXXXX            # login FTP
LH_REMOTE_DIR=/kontekstownik.pl # katalog przypisany do domeny w: Serwery → Strony WWW (sprawdź, nie zgaduj)
LH_KEYCHAIN_SERVICE=kontekstownik-lh-ftp
